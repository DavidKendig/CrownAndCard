<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
<!--
	Copied next to CrownAndCardLauncher.exe by build.ps1 (the .NET Framework
	runtime reads <exe>.exe.config automatically). Pairs with the PerMonitorV2
	declaration in app.manifest: without this switch, WinForms leaves resizing
	on a DPI change to the OS's bitmap stretch instead of re-laying out controls,
	which is the other half of the "opens undersized/blurry" bug.
-->
<configuration>
	<runtime>
		<AppContextSwitchOverrides value="Switch.System.Windows.Forms.EnableWindowsFormsHighDpiAutoResizing=true" />
	</runtime>
</configuration>
